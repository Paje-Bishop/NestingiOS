# Copy to .env and fill in real values. .env is gitignored.
#
# Postgres connection string. For Supabase, prefer the IPv4 Session Pooler string
# (Dashboard -> Connect -> Session pooler), since the direct db.<ref>.supabase.co host is
# IPv6-only. Append ?sslmode=no-verify if you hit self-signed cert chain errors.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=no-verify

# API server port (server reads process.env.PORT directly)
PORT=8080
NODE_ENV=development
